{
  "$defs": {
    "AccessMode": {
      "description": "Contract-level Resource and Session access modes.",
      "enum": [
        "SHARED",
        "EXCLUSIVE"
      ],
      "title": "AccessMode",
      "type": "string"
    },
    "ArtifactDescriptor": {
      "additionalProperties": false,
      "description": "Logical metadata for persistent evidence or generated non-secret data.",
      "properties": {
        "artifact_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/SymbolicName"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by_run": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
          "title": "Created By Run",
          "type": "string"
        },
        "media_type": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "metadata": {
          "$ref": "#/$defs/JsonObject"
        },
        "sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256Digest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "storage_ref": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
          "title": "Storage Ref",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "storage_ref",
        "created_by_run",
        "created_at"
      ],
      "title": "ArtifactDescriptor",
      "type": "object"
    },
    "CapabilityDefinition": {
      "additionalProperties": false,
      "description": "Static, discoverable metadata for a Capability implementation.",
      "properties": {
        "capability_id": {
          "$ref": "#/$defs/CapabilityId"
        },
        "contract_version": {
          "$ref": "#/$defs/VersionString"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/DependencyDeclaration"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "description": {
          "$ref": "#/$defs/NonEmptyStr"
        },
        "execution": {
          "$ref": "#/$defs/ExecutionCharacteristics"
        },
        "implementation_version": {
          "$ref": "#/$defs/VersionString"
        },
        "interaction_surfaces": {
          "$ref": "#/$defs/InteractionSurfaceDeclaration"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/OperationDefinition"
          },
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        },
        "side_effects": {
          "items": {
            "$ref": "#/$defs/SideEffectDeclaration"
          },
          "minItems": 1,
          "title": "Side Effects",
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/ShortStr"
        }
      },
      "required": [
        "capability_id",
        "contract_version",
        "implementation_version",
        "title",
        "description",
        "operations",
        "execution",
        "interaction_surfaces",
        "side_effects",
        "dependencies"
      ],
      "title": "CapabilityDefinition",
      "type": "object"
    },
    "CapabilityId": {
      "maxLength": 255,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$",
      "type": "string"
    },
    "CapabilityInvocation": {
      "additionalProperties": false,
      "description": "Validated request to execute one Capability operation.",
      "properties": {
        "capability_id": {
          "$ref": "#/$defs/CapabilityId"
        },
        "inputs": {
          "$ref": "#/$defs/JsonObject"
        },
        "mission_ref": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
          "title": "Mission Ref",
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/OperationName"
        },
        "parent_run_ref": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Run Ref"
        },
        "run_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
          "title": "Run Id",
          "type": "string"
        },
        "workflow_run_ref": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow Run Ref"
        }
      },
      "required": [
        "run_id",
        "capability_id",
        "operation",
        "mission_ref"
      ],
      "title": "CapabilityInvocation",
      "type": "object"
    },
    "CapabilityOutcome": {
      "additionalProperties": false,
      "description": "Assessment meaning kept separate from execution lifecycle status.",
      "properties": {
        "category": {
          "$ref": "#/$defs/CapabilityOutcomeCategory"
        },
        "code": {
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolicName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "details": {
          "$ref": "#/$defs/JsonObject"
        },
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonEmptyStr"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "category"
      ],
      "title": "CapabilityOutcome",
      "type": "object"
    },
    "CapabilityOutcomeCategory": {
      "description": "Shared high-level assessment outcome categories.",
      "enum": [
        "SUCCESS",
        "NEGATIVE",
        "PARTIAL",
        "UNKNOWN"
      ],
      "title": "CapabilityOutcomeCategory",
      "type": "string"
    },
    "CapabilityResult": {
      "additionalProperties": false,
      "description": "Universal envelope returned by a terminal CapabilityRun.",
      "properties": {
        "artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactDescriptor"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "diagnostics": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "effects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "title": "Effects",
          "type": "array"
        },
        "execution_status": {
          "$ref": "#/$defs/CapabilityRunStatus"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "observations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "title": "Observations",
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/CapabilityOutcome"
        },
        "resources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResourceDescriptor"
          },
          "title": "Resources",
          "type": "array"
        },
        "run_ref": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
          "title": "Run Ref",
          "type": "string"
        },
        "sessions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SessionDescriptor"
          },
          "title": "Sessions",
          "type": "array"
        }
      },
      "required": [
        "run_ref",
        "execution_status",
        "outcome"
      ],
      "title": "CapabilityResult",
      "type": "object"
    },
    "CapabilityRun": {
      "additionalProperties": false,
      "description": "One concrete Capability operation execution.",
      "properties": {
        "capability_id": {
          "$ref": "#/$defs/CapabilityId"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "mission_ref": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
          "title": "Mission Ref",
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/OperationName"
        },
        "parent_run_ref": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Run Ref"
        },
        "run_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
          "title": "Run Id",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "$ref": "#/$defs/CapabilityRunStatus"
        },
        "workflow_run_ref": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow Run Ref"
        }
      },
      "required": [
        "run_id",
        "capability_id",
        "operation",
        "mission_ref",
        "status",
        "created_at"
      ],
      "title": "CapabilityRun",
      "type": "object"
    },
    "CapabilityRunStatus": {
      "description": "Lifecycle state for a CapabilityRun.",
      "enum": [
        "CREATED",
        "QUEUED",
        "RUNNING",
        "WAITING_INPUT",
        "WAITING_RESOURCE",
        "PAUSED",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "TIMED_OUT"
      ],
      "title": "CapabilityRunStatus",
      "type": "string"
    },
    "Checkpoint": {
      "additionalProperties": false,
      "description": "Durable logical continuation state without live runtime objects.",
      "properties": {
        "artifact_refs": {
          "default": [],
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
            "type": "string"
          },
          "title": "Artifact Refs",
          "type": "array"
        },
        "checkpoint_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
          "title": "Checkpoint Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "pending_interaction_ref": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pending Interaction Ref"
        },
        "phase": {
          "$ref": "#/$defs/SymbolicName"
        },
        "resource_refs": {
          "default": [],
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
            "type": "string"
          },
          "title": "Resource Refs",
          "type": "array"
        },
        "run_ref": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
          "title": "Run Ref",
          "type": "string"
        },
        "session_refs": {
          "default": [],
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
            "type": "string"
          },
          "title": "Session Refs",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "checkpoint_id",
        "run_ref",
        "phase",
        "state",
        "created_at"
      ],
      "title": "Checkpoint",
      "type": "object"
    },
    "DependencyDeclaration": {
      "additionalProperties": false,
      "description": "A capability, tool, runtime, or Resource requirement.",
      "properties": {
        "dependency_type": {
          "$ref": "#/$defs/DependencyType"
        },
        "identifier": {
          "$ref": "#/$defs/SymbolicName"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "version_spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShortStr"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "dependency_type",
        "identifier"
      ],
      "title": "DependencyDeclaration",
      "type": "object"
    },
    "DependencyType": {
      "description": "Kinds of capability implementation dependencies.",
      "enum": [
        "capability",
        "tool",
        "runtime",
        "resource"
      ],
      "title": "DependencyType",
      "type": "string"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "description": "Execution-related information that is not target state.",
      "properties": {
        "artifact_refs": {
          "default": [],
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
            "type": "string"
          },
          "title": "Artifact Refs",
          "type": "array"
        },
        "code": {
          "$ref": "#/$defs/SymbolicName"
        },
        "details": {
          "$ref": "#/$defs/JsonObject"
        },
        "message": {
          "$ref": "#/$defs/NonEmptyStr"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "run_ref": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Ref"
        },
        "severity": {
          "$ref": "#/$defs/DiagnosticSeverity"
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "occurred_at"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "DiagnosticSeverity": {
      "description": "Severity of execution-related diagnostic information.",
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "title": "DiagnosticSeverity",
      "type": "string"
    },
    "Effect": {
      "additionalProperties": false,
      "description": "An actual target-side or assessment-context change caused by execution.",
      "properties": {
        "action": {
          "$ref": "#/$defs/SymbolicName"
        },
        "after_ref": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Ref"
        },
        "before_ref": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Ref"
        },
        "confirmed": {
          "title": "Confirmed",
          "type": "boolean"
        },
        "effect_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
          "title": "Effect Id",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "intentional": {
          "title": "Intentional",
          "type": "boolean"
        },
        "metadata": {
          "$ref": "#/$defs/JsonObject"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "reversibility": {
          "$ref": "#/$defs/EffectReversibility"
        },
        "run_ref": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
          "title": "Run Ref",
          "type": "string"
        },
        "subject_ref": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Ref"
        },
        "type": {
          "$ref": "#/$defs/SymbolicName"
        }
      },
      "required": [
        "effect_id",
        "type",
        "action",
        "run_ref",
        "occurred_at",
        "intentional",
        "confirmed"
      ],
      "title": "Effect",
      "type": "object"
    },
    "EffectReversibility": {
      "additionalProperties": false,
      "description": "Known cleanup and reversibility information for an Effect.",
      "properties": {
        "cleanup_capability_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilityId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cleanup_inputs": {
          "$ref": "#/$defs/JsonObject"
        },
        "cleanup_required": {
          "default": false,
          "title": "Cleanup Required",
          "type": "boolean"
        },
        "cleanup_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolicName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonEmptyStr"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reversible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reversible"
        }
      },
      "title": "EffectReversibility",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "description": "A persistable notification carrying JSON-compatible data.",
      "properties": {
        "event_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
          "title": "Event Id",
          "type": "string"
        },
        "mission_ref": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
          "title": "Mission Ref",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/JsonObject"
        },
        "source_ref": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,254}$",
          "title": "Source Ref",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SymbolicName"
        }
      },
      "required": [
        "event_id",
        "type",
        "timestamp",
        "mission_ref",
        "source_ref",
        "payload"
      ],
      "title": "Event",
      "type": "object"
    },
    "ExecutionCharacteristics": {
      "additionalProperties": false,
      "description": "Shared execution behavior used for routing, policy, and audit.",
      "properties": {
        "asynchronous": {
          "const": true,
          "default": true,
          "title": "Asynchronous",
          "type": "boolean"
        },
        "duration": {
          "$ref": "#/$defs/ExecutionDuration"
        },
        "interaction": {
          "$ref": "#/$defs/ExecutionInteraction"
        },
        "supports_cancellation": {
          "default": false,
          "title": "Supports Cancellation",
          "type": "boolean"
        },
        "supports_checkpointing": {
          "default": false,
          "title": "Supports Checkpointing",
          "type": "boolean"
        }
      },
      "required": [
        "duration",
        "interaction"
      ],
      "title": "ExecutionCharacteristics",
      "type": "object"
    },
    "ExecutionDuration": {
      "description": "Shared duration behavior advertised by a capability.",
      "enum": [
        "one_shot",
        "long_running"
      ],
      "title": "ExecutionDuration",
      "type": "string"
    },
    "ExecutionInteraction": {
      "description": "Whether execution depends on persistent stateful context.",
      "enum": [
        "stateless",
        "stateful"
      ],
